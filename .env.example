# The backend reads DATABASE_URL from the environment. If unset it falls back to SQLite (sqlite:///./local.db).
# Real values live in .env.local (gitignored), written by `neon init` / `neon env pull` for the linked Neon project.
# Load it before starting the backend:   set -a; . ./.env.local; set +a
# Prod (Render): paste the same pooled DATABASE_URL into the service's Environment settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
